{
  "name": "anypay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.js --verbose --detectOpenHandles",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage --coverageReporters=text --coverageReporters=lcov"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest"
      ]
    },
    "doctor": {
      "skipChecks": [
        "checkGlobalCli"
      ]
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "axios": "^1.7.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-file-system": "~18.0.12",
    "expo-image-picker": "~16.0.6",
    "expo-local-authentication": "~15.0.2",
    "expo-notifications": "~0.29.14",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "^30.5.1",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@expo/config-plugins": "~9.0.0",
    "@expo/prebuild-config": "~8.0.0"
  }
