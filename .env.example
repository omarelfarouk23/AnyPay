# Anypay Environment Variables
# Never commit this file to version control
# Copy to .env and fill in your values

# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://api.anypay.dz/v1
EXPO_PUBLIC_API_TIMEOUT=15000

# WebSocket
EXPO_PUBLIC_WS_URL=wss://ws.anypay.dz

# Authentication
EXPO_PUBLIC_AUTH_REFRESH_THRESHOLD=300

# Push Notifications
EXPO_PUBLIC_FCM_SERVER_KEY=
EXPO_PUBLIC_APNS_TEAM_ID=
EXPO_PUBLIC_APNS_BUNDLE_ID=com.anypay.app

# Payment (placeholder — real provider keys from env)
EXPO_PUBLIC_PAYMENT_PROVIDER=local

# App
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development
